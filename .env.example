# Copy this file to .env.local and fill in real values. Never commit real
# secrets - .env.local is gitignored.

# --- Jumio KYX Orchestration API (identity verification) ---
# Only used by the legacy /quick-buy demo page (src/lib/jumio.ts, calls
# Jumio directly). The real checkout flow (/checkout-entry, /checkout-widget)
# does NOT use these - its Jumio step goes through CHECKOUT_API_BASE_URL
# below instead.
# Get these from the Jumio customer portal for the sandbox/production
# workspace this app should verify against.
JUMIO_API_TOKEN=
JUMIO_API_SECRET=
JUMIO_WORKFLOW_ID=
# Jumio datacenter id (e.g. "amer-1", "eu-1", "sg-1"). Defaults to "amer-1"
# if unset - must match the datacenter your Jumio workspace lives in.
JUMIO_DATACENTER=amer-1

# --- Real checkout backend (peptiva order/payment/KYC API) ---
# Base URL of the backend that /api/checkout/* proxies to - handles email
# verification, sign-in, Jumio KYC, and payment for the real flow.
CHECKOUT_API_BASE_URL=
# Client-exposed twin of the above - the browser needs this directly to
# open the SignalR hub connection for live Jumio status pushes
# (src/lib/signalr.ts). Must match CHECKOUT_API_BASE_URL.
NEXT_PUBLIC_CHECKOUT_API_BASE_URL=
# Opaque per-integration key identifying this widget to the checkout
# backend, sent as a header on every request. FALLBACK ONLY - the
# checkout URL's own ?quickBuyKey= param (same role as deposit-onboarding's)
# takes precedence when supplied by the embedding host; this is only used
# when no key is present on the URL (e.g. local/manual testing). Confirm the
# exact header name/value format with backend - see src/lib/checkoutApi.ts.
CHECKOUT_WIDGET_KEY=
# Origin allowed to embed /checkout-entry in an iframe or link to it
# (used for the frame-ancestors CSP header). e.g. https://peptiva.com
CHECKOUT_ALLOWED_PARENT_ORIGIN=
# Same origin as above, exposed client-side - used as the postMessage
# targetOrigin when the checkout iframe reports completion back to
# /checkout-entry. Must match CHECKOUT_ALLOWED_PARENT_ORIGIN.
NEXT_PUBLIC_CHECKOUT_ALLOWED_PARENT_ORIGIN=
