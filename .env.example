# Jumio KYX Orchestration API (sandbox) - used by /api/jumio/* route handlers
# for the Quick Buy widget's identity verification step.
#
# Get these from the Jumio portal (customer.jumio.com), Settings > API
# credentials (labeled Client ID/Client Secret there - same pair, used as
# JUMIO_API_TOKEN/JUMIO_API_SECRET here):
JUMIO_API_TOKEN=
JUMIO_API_SECRET=
# Workflow Builder > your workflow's definition key
JUMIO_WORKFLOW_ID=
# Jumio datacenter/region id, e.g. "amer-1" - NOT "us"/"eu"/"sg". Find it on
# the same API credentials page, or infer it from your account's iframe host
# (https://<merchant>.web.<region>.jumio.ai).
JUMIO_DATACENTER=amer-1
